{
  "name": "tate-douga-maker",
  "version": "0.1.0",
  "private": true,
  "description": "音声から縦型(9:16)動画を作るローカル編集ツール",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/server/main.js",
    "serve": "node dist/server/main.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "6.0.2"
  }
}
