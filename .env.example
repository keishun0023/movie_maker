# 環境設定の例(秘密情報は不要です)。必要なものだけ環境変数として設定してください。
# 例: PORT=5179 ./start.command

# 待ち受けポート(初期値 5178)。127.0.0.1 のみで待ち受けます
PORT=5178
# プロジェクト・モデル・プリセットの保存先(初期値 ~/TateDougaMaker)
TDM_DATA_DIR=
# 文字起こしモデルの保存先(初期値 $TDM_DATA_DIR/models)
TDM_MODELS_DIR=
# ツールの場所を明示する場合(通常は自動検出)
FFMPEG_PATH=
FFPROBE_PATH=
WHISPER_CLI=
# 書き出しの中間ファイルを残す(不具合調査用)
TDM_KEEP_WORK=
